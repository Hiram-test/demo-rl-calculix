{
  "version": "2.0.0",
  "skills": [
    {"id": "compile_task_contract", "owner": "deterministic", "purpose": "Freeze QoI, error, resource, feedback and action constraints.", "inputs": ["raw_task"], "outputs": ["TaskContract"], "hard_gates": ["qoi_present", "error_tolerance_present", "resource_budget_present", "h_max_present"], "fallback": "request_missing_fields"},
    {"id": "derive_theory_evidence", "owner": "llm_plus_symbolic", "purpose": "Translate analytic or asymptotic theory into testable spatial and intervention predictions.", "inputs": ["TaskContract", "theory_registry"], "outputs": ["TheoryEvidence"], "hard_gates": ["assumption_match", "derivation_or_source_present", "failure_condition_present"], "fallback": "mark_out_of_domain"},
    {"id": "extract_coarse_evidence", "owner": "deterministic_fea", "purpose": "Extract Dörfler support, indicators, gradients, QoI sensitivity and mesh-quality evidence from a common coarse solve.", "inputs": ["TaskContract", "coarse_mesh", "coarse_solution"], "outputs": ["CoarseEvidencePacket"], "hard_gates": ["solver_balance_ok", "mesh_quality_ok", "indicator_available"], "fallback": "refine_global_probe"},
    {"id": "infer_mechanism_graph", "owner": "llm", "purpose": "Fuse theory and coarse evidence into falsifiable mechanism nodes and region proposals.", "inputs": ["TaskContract", "TheoryEvidence", "CoarseEvidencePacket"], "outputs": ["MechanismGraph"], "hard_gates": ["evidence_binding", "counter_hypothesis", "falsification_condition", "uncertainty_reported"], "fallback": "abstain_and_probe"},
    {"id": "assess_ph", "owner": "llm_plus_method_cards", "purpose": "Predict route-specific prior-compression components, feedback depth, physical work and risk.", "inputs": ["MechanismGraph", "candidate_partitions", "method_cards", "domain_distance"], "outputs": ["PHAssessment"], "hard_gates": ["confidence_interval", "unknown_component_handling", "validation_card_available"], "fallback": "conservative_ph_bound"},
    {"id": "select_hotspot_partition", "owner": "hybrid", "purpose": "Construct Dörfler, LLM and evidence-gated fused supports.", "inputs": ["MechanismGraph", "CoarseEvidencePacket", "budget"], "outputs": ["DPartition", "LPartition", "FusedPartition"], "hard_gates": ["high_qoi_indicator_recall", "conflict_probe", "support_budget_feasible"], "fallback": "dynamic_dorfler_support"},
    {"id": "route_by_ph", "owner": "llm_plus_optimizer", "purpose": "Select a feasible route under success-probability, feedback, budget and risk constraints.", "inputs": ["PHAssessment", "risk_limit", "remaining_budget", "ph_gap_history"], "outputs": ["RouteDecision"], "hard_gates": ["success_probability_constraint", "skill_domain_constraint", "fallback_chain_present"], "fallback": "DM_D"},
    {"id": "execute_regional_method", "owner": "deterministic_runtime", "purpose": "Execute Dörfler, PSO, DQN or supervised sizing under one evaluator and accounting contract.", "inputs": ["RouteDecision", "TaskContract", "partition"], "outputs": ["ExecutionTrace"], "hard_gates": ["count_every_fea", "preserve_task_contract", "mesh_quality_check"], "fallback": "stop_and_audit"},
    {"id": "audit_execution", "owner": "deterministic_plus_llm", "purpose": "Compare mechanism response and assessed PH with executed evidence and decide acceptance or fallback.", "inputs": ["ExecutionTrace", "PHAssessment", "MechanismGraph"], "outputs": ["ExecutionAudit"], "hard_gates": ["true_error_or_estimator_check", "resource_check", "ph_recompute", "mechanism_response_check"], "fallback": "route_fallback"},
    {"id": "calibrate_ph_gap", "owner": "statistical", "purpose": "Learn method- and mechanism-conditioned PH bias and uncertainty from assessed-to-executed gaps.", "inputs": ["PHAssessment", "ExecutionAudit"], "outputs": ["PHCalibrationCard"], "hard_gates": ["held_out_calibration", "seed_aggregation", "tail_risk_report"], "fallback": "use_upper_confidence_h_and_lower_confidence_p"},
    {"id": "inject_robustness_perturbation", "owner": "deterministic", "purpose": "Generate controlled evidence, model, optimizer and solver failures.", "inputs": ["TaskContract", "perturbation_spec"], "outputs": ["PerturbedTask", "expected_failure_mode"], "hard_gates": ["single_factor_traceability", "severity_recorded", "base_case_linked"], "fallback": "reject_invalid_perturbation"}
  ]
}
