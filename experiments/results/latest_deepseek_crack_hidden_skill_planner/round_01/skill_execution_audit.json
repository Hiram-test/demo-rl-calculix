  "experiment_spec": {
    "objective": "评估三个现有网格（h_local=5,3.33,2.5mm）的裂尖应力强度因子KI随网格细化的收敛行为，以确定是否需要继续加密。",
    "scope": "experiment",
    "interventions": [
      "使用节点对齐的裂纹微增能量差法（虚拟裂纹扩展法）计算每个网格的能量释放率并转换为KI。"
    ],
    "invariants": [
      "材料参数（E=210000 MPa, ν=0.3）",
      "几何尺寸（200×200 mm板，2a=40 mm中心裂纹）",
      "载荷（100 MPa对称拉应力）",
      "边界条件（对称边界）",
      "平面应力假设"
    ],
    "observables": [
      {
        "id": "ki_values",
        "description": "三个网格（h_local=5,3.33,2.5mm）的应力强度因子KI (MPa√mm)"
      }
    ],
    "derivations": [
      {
        "id": "ki_relative_change",
        "description": "各个网格KI相对于最细网格（h_local=2.5mm）的百分比变化，由能量序列输出中获取"
      }
    ],
    "external_dependencies": [],
    "acceptance_rule": "如果三个网格间的KI最大相对变化小于2%，且KI值与理论解KI_theory=σ√(πa) sec(πa/W)（其中σ=100 MPa, a=20 mm, W=200 mm）的最大偏差小于5%，则认为KI已收敛，无需进一步加密；否则根据趋势决定是否需要更细网格。",
    "completion_scope": "current_step"
  },
